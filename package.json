{
  "name": "my-blog",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "check": "node scripts/check-broken-links.js && node scripts/check-typography.js --changed",
    "fix": "node scripts/check-typography.js --fix --changed && node scripts/check-broken-links.js --fix",
    "check:text": "node scripts/check-typography.js",
    "check:text:list": "node scripts/check-typography.js --files-only",
    "fix:all": "node scripts/check-typography.js --fix",
    "pull": "git pull",
    "prepare-data": "node scripts/prepare-data.js",
    "prepare-data:full": "node scripts/prepare-data.js && node scripts/gen-photo-thumbs.js && node scripts/gen-poster-thumbs.js && node scripts/gen-chess-eval.js && node scripts/gen-search-index.js",
    "start": "npm run prepare-data && node scripts/gen-photo-thumbs.js && node scripts/gen-poster-thumbs.js && node scripts/gen-search-index.js && docusaurus start",
    "start:fast": "docusaurus start",
    "build": "npm run prepare-data:full && docusaurus build",
    "push": "npm run check && node scripts/prepare-data.js --strict && npm run build && node scripts/push.js",
    "push:fast": "npm run check && node scripts/prepare-data.js --strict && node scripts/gen-chess-eval.js && node scripts/push.js",
    "new": "node scripts/new-post.js",
    "gen-albums": "node scripts/gen-albums.js",
    "gen-thumbs": "node scripts/gen-photo-thumbs.js && node scripts/gen-poster-thumbs.js",
    "gen-chess": "node scripts/gen-chess-eval.js",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "^3.0.0",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "clsx": "^2.0.0",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-fast-marquee": "^1.6.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "sharp": "^0.34.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
