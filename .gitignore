# --- 依賴與編譯 ---
node_modules/
.docusaurus/
.cache-loader/
build/
dist/
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# --- 環境變數 (最重要) ---
.env
.env.*
# 例外：保留一份範例檔，告訴別人需要哪些變數（gitignore 不支援行尾註解，註解必須獨立一行）
!.env.example

# --- 作業系統垃圾檔案 ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- 編輯器設定 (選配) ---
# 如果你不希望把個人的 VS Code 或 WebStorm 設定上傳
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 日誌與除錯 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.log

# --- 特殊大檔案排除 (重要！) ---
# 如果你有 200GB 的照片或大檔案放在 static/ 下，請務必在此排除
# 例如：
# static/my-huge-photos/
# *.mp4
# *.zip

# --- 個人暫存區（截圖、試算腳本），不進版控 ---
scratch/

# --- 建置時由 npm run data 產生的檔案 ---
# 正式站與 CI 都跑 npm run build（會先跑 data），npm start 也會先跑 data；若要直接用 npm run docusaurus -- start，需先跑一次 npm run data
# 注意：chessEvals.json（評估快取）與 albumsData.json / albums.json（合併狀態）會被讀回當輸入，必須留在版控
src/data/generated/blogrollData.js
src/data/generated/photosData.json
src/data/generated/contribution-data.json
src/data/generated/nowPosterData.json
static/search-index.json
# /photography 照片牆縮圖（scripts/gen-photo-thumbs.js 產生）
static/photo-thumbs/
# 排名清單海報縮圖（scripts/gen-poster-thumbs.js 產生）
static/poster-thumbs/
